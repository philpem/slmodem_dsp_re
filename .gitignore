# build products
*.o
*.a
*.so
*.d
build/
build-cov/
test/harness/*_test
test/harness/*_diff

# generated reference objects (derived from ../slmodemd/dsplibs.o at build time)
*_ref.o
*_weak.o
symmap.txt

# vendored test peer; its build tree is not ours.  No trailing slash: with
# one, the pattern matches a directory but NOT a symlink, and a `git worktree`
# checkout wants to symlink this rather than rebuild 36 MB of it.
third_party/spandsp

# python
__pycache__/
*.pyc

# generated by tools/mewtsweep.py
docs/mewt_survivors.txt

# mutate.py holds this while a run is in progress (finding 705)
test/mutations/.running

# Other sessions work in worktrees under here.  `git add -A` swept nine of
# them into a commit once; they are embedded git repositories and belong to
# nobody in this tree.
.claude/

# generated on demand by `make worklist`; a committed copy would rot,
# because `make phase` deliberately does not regenerate it (unlike coverage.md)
docs/worklist.md

# The reference driver is TRACKED despite *.o above -- ref/slmodemd/dsplibs.o
# is the object under reconstruction, not a build product.
!ref/**
testbench/linemodels/*.png
