[
 {
  "label": "phase 3 demodulator stores at +0x00, not +0x08",
  "find": "\tsessionFlag = flag;\n\tphase3Modulator.setSessionFlag(flag);",
  "replace": "\t*(unsigned int *)this = flag;\n\tphase3Modulator.setSessionFlag(flag);"
 },
 {
  "label": "phase 3 demodulator reaches the modulator through a pointer",
  "find": "\tphase3Modulator.setSessionFlag(flag);",
  "replace": "\t(*(V90Phase3Modulator **)&phase3Modulator)->setSessionFlag(flag);"
 },
 {
  "label": "modulator calls only the phase 3 half",
  "find": "\tphase3Modulator->setSessionFlag(flag);\n\tphase4Modulator->setSessionFlag(flag);",
  "replace": "\tphase3Modulator->setSessionFlag(flag);"
 },
 {
  "label": "modulator embeds rather than dereferences",
  "find": "\tphase3Modulator->setSessionFlag(flag);",
  "replace": "\t((V90Phase3Modulator *)&phase3Modulator)->setSessionFlag(flag);"
 },
 {
  "label": "demodulator prints after storing the flag",
  "find": "\tedprintf(\"V90Demodulator: setSessionFlag, flag = %d\\r\\n\", flag);\n\n\tsessionFlag = flag;",
  "replace": "\tsessionFlag = flag;\n\n\tedprintf(\"V90Demodulator: setSessionFlag, flag = %d\\r\\n\", flag);"
 },
 {
  "label": "demodulator prints the field rather than the argument",
  "find": "\tedprintf(\"V90Demodulator: setSessionFlag, flag = %d\\r\\n\", flag);",
  "replace": "\tedprintf(\"V90Demodulator: setSessionFlag, flag = %d\\r\\n\", sessionFlag);"
 },
 {
  "label": "modem's two sides are swapped",
  "find": "\tif (which == 0)\n\t\tmodulator->setSessionFlag(flag);\n\telse if (which == 1)\n\t\tdemodulator->setSessionFlag(flag);",
  "replace": "\tif (which == 1)\n\t\tmodulator->setSessionFlag(flag);\n\telse if (which == 0)\n\t\tdemodulator->setSessionFlag(flag);"
 },
 {
  "label": "modem falls through to the modulator",
  "find": "\tif (which == 0)\n\t\tmodulator->setSessionFlag(flag);\n\telse if (which == 1)\n\t\tdemodulator->setSessionFlag(flag);",
  "replace": "\tif (which == 1)\n\t\tdemodulator->setSessionFlag(flag);\n\telse\n\t\tmodulator->setSessionFlag(flag);"
 },
 {
  "label": "modem stores the flag only when it calls something",
  "find": "\tsessionFlag = flag;\n\n\tif (which == 0)",
  "replace": "\tif (which == 0 || which == 1)\n\t\tsessionFlag = flag;\n\n\tif (which == 0)"
 },
 {
  "label": "modem reads the side after storing the flag",
  "find": "\tint which = side;\n\n\tsessionFlag = flag;",
  "replace": "\tint which;\n\n\tsessionFlag = flag;\n\twhich = side;"
 },
 {
  "label": "phase 4 demodulator's subobject sits at +0x4c",
  "find": "\tsessionFlag = flag;\n\tphase4Modulator.setSessionFlag(flag);",
  "replace": "\tsessionFlag = flag;\n\t((V90Phase4Modulator *)((char *)this + 0x4c))->setSessionFlag(flag);"
 },
 {
  "label": "phase 3 demodulator's subobject sits at +0x30",
  "find": "\tsessionFlag = flag;\n\tphase3Modulator.setSessionFlag(flag);",
  "replace": "\tsessionFlag = flag;\n\t((V90Phase3Modulator *)((char *)this + 0x30))->setSessionFlag(flag);"
 },
 {
  "label": "the modulator's flag goes to +0x2c",
  "find": "\tsessionFlag = flag;\n\tphase3Modulator->setSessionFlag(flag);",
  "replace": "\t*(unsigned int *)((char *)this + 0x2c) = flag;\n\tphase3Modulator->setSessionFlag(flag);"
 },
 {
  "label": "the demodulator's flag goes to +0x2c",
  "find": "\tsessionFlag = flag;\n\tphase3Demodulator->setSessionFlag(flag);",
  "replace": "\t*(unsigned int *)((char *)this + 0x2c) = flag;\n\tphase3Demodulator->setSessionFlag(flag);"
 },
 {
