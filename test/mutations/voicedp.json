[
 {
  "note": "src/service/voicedp.c against build/test/t_voicedp.  voice_set_online, voice_set_duplex and voice_online, plus the shared constants those three read.  The Rx.c/Tx.c/duplex.c handlers moved to their own translation units (finding F11386); their mutations live in voicedprx.json, voicedptx.json and voicedpdx.json."
 },
 {
  "label": "voice_set_online writes the wrong mode",
  "find": "\tv->mode = 2;\n\tv->handler = voice_online;",
  "replace": "\tv->mode = 3;\n\tv->handler = voice_online;"
 },
 {
  "label": "voice_set_online installs the duplex handler",
  "find": "\tv->handler = voice_online;\n\tdetector_set_enable",
  "replace": "\tv->handler = voice_duplex;\n\tdetector_set_enable"
 },
 {
  "label": "voice_set_online enables the detector with the duplex constant",
  "find": "\tdetector_set_enable(v->detector, v->detector_enable);",
  "replace": "\tdetector_set_enable(v->detector, 0x24);"
 },
 {
  "label": "voice_set_duplex writes the online mode",
  "find": "\tv->mode = 3;\n\tv->handler = voice_duplex;",
  "replace": "\tv->mode = 2;\n\tv->handler = voice_duplex;"
 },
 {
  "label": "voice_set_duplex reads the context's mask instead of its constant",
  "find": "\tdetector_set_enable(v->detector, 0x24);",
  "replace": "\tdetector_set_enable(v->detector, (short)v->detector_enable);"
 },
 {
  "label": "the beep's full scale is FDSP_DP_Run's 32000 rather than 30000",
  "find": "#define VOICE_BEEP_FULL_SCALE\t30000.0f",
  "replace": "#define VOICE_BEEP_FULL_SCALE\t32000.0f"
 },
 {
  "label": "the linear output format test admits one value too many",
  "find": "#define VOICE_OUT_IS_LINEAR(v)\t((unsigned int)((v)->out_format - 1) <= 1u)",
  "replace": "#define VOICE_OUT_IS_LINEAR(v)\t((unsigned int)((v)->out_format - 1) <= 2u)"
 },
 {
  "label": "voice_online tests beep_done the wrong way round",
  "find": "\tif (v->beep_done) {\n\t\tif (VOICE_OUT_IS_LINEAR(v)) {",
  "replace": "\tif (!v->beep_done) {\n\t\tif (VOICE_OUT_IS_LINEAR(v)) {"
 },
 {
  "label": "voice_online's beep sample is not scaled before the cast",
  "find": "\t\t\ttx_lin[i] = (short)(s * VOICE_BEEP_FULL_SCALE);",
  "replace": "\t\t\ttx_lin[i] = (short)s;"
 },
 {
  "label": "voice_online stops the beep loop on the wrong return value",
  "find": "\t\twhile (i < *countp && r != 1) {\n\t\t\tfloat s;",
  "replace": "\t\twhile (i < *countp && r != 2) {\n\t\t\tfloat s;"
 },
 {
  "label": "voice_online's linear tail is not zeroed",
  "find": "\t\twhile (i < *countp)\n\t\t\ttx_lin[i++] = 0;",
  "replace": "\t\twhile (i < *countp)\n\t\t\ttx_lin[i++] = 1;"
 },
 {
  "label": "voice_online's float tail is not zeroed",
  "find": "\t\twhile (i < *countp)\n\t\t\trx_flt[i++] = 0.0f;",
  "replace": "\t\twhile (i < *countp)\n\t\t\trx_flt[i++] = 1.0f;"
 },
 {
  "label": "voice_online does not latch beep_done when the queue empties",
  "find": "\t\tv->beep_done = 1;\n\t\tFDSP_Kernel_SetInternalBeepInProgress(0);\n\t\tret = 1;",
  "replace": "\t\tFDSP_Kernel_SetInternalBeepInProgress(0);\n\t\tret = 1;"
 },
 {
  "label": "voice_online answers 0 rather than 1 on the block that ends the beep",
  "find": "\t\tFDSP_Kernel_SetInternalBeepInProgress(0);\n\t\tret = 1;\n\t}",
  "replace": "\t\tFDSP_Kernel_SetInternalBeepInProgress(0);\n\t}"
 },
 {
  "label": "D997's dead store is repaired, so the caller sees the sample count",
  "find": "\t*hostcount = *countp;\n\t*countp = 0;\n\t*hostcount = 0;",
  "replace": "\t*hostcount = *countp;\n\t*countp = 0;"
 },
 {
  "label": "voice_online leaves the sample count alone",
  "find": "\t*countp = 0;\n\t*hostcount = 0;",
  "replace": "\t*hostcount = 0;"
 },
 {
  "label": "voice_online drops the second half of its mode test",
  "find": "\tif (v->int_0014 != v->mode && v->int_0014 != 0)\n\t\tret = VOICE_ONLINE_MODE_STATUS;",
  "replace": "\tif (v->int_0014 != v->mode)\n\t\tret = VOICE_ONLINE_MODE_STATUS;"
 },
 {
  "label": "voice_online answers the duplex code on a mode mismatch",
  "find": "#define VOICE_ONLINE_MODE_STATUS\t2",
  "replace": "#define VOICE_ONLINE_MODE_STATUS\t5"
 }
]