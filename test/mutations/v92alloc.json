[
 {
  "label": "shrink one constellation allocation to half",
  "find": "\tp->constellations[2] = new int[V92_PARAMSINFO_CONSTELLATION_SZ / sizeof(int)];",
  "replace": "\tp->constellations[2] = new int[(V92_PARAMSINFO_CONSTELLATION_SZ / 2) / sizeof(int)];"
 },
 {
  "label": "drop the sixth constellation allocation",
  "find": "\tp->constellations[5] = new int[V92_PARAMSINFO_CONSTELLATION_SZ / sizeof(int)];\n}",
  "replace": "}"
 },
 {
  "label": "store the first constellation at the fourth slot",
  "find": "\tp->constellations[0] = new int[V92_PARAMSINFO_CONSTELLATION_SZ / sizeof(int)];\n\tp->constellations[1]",
  "replace": "\tp->constellations[3] = new int[V92_PARAMSINFO_CONSTELLATION_SZ / sizeof(int)];\n\tp->constellations[1]"
 },
 {
  "label": "allocate the coefficient banks at the constellation size",
  "find": "\tp->p1 = new float[V92_PARAMSINFO_FILTERCOEF_SZ / sizeof(float)];",
  "replace": "\tp->p1 = new float[V92_PARAMSINFO_CONSTELLATION_SZ / sizeof(float)];"
 },
 {
  "label": "drop the fourth coefficient bank",
  "find": "\tp->p2 = new float[V92_PARAMSINFO_FILTERCOEF_SZ / sizeof(float)];\n}",
  "replace": "}"
 },
 {
  "label": "add a fifth coefficient bank the object does not allocate",
  "find": "\tp->p2 = new float[V92_PARAMSINFO_FILTERCOEF_SZ / sizeof(float)];\n}",
  "replace": "\tp->p2 = new float[V92_PARAMSINFO_FILTERCOEF_SZ / sizeof(float)];\n\tp->constellations[0] = new int[V92_PARAMSINFO_FILTERCOEF_SZ / sizeof(int)];\n}"
 },
 {
  "label": "null the constellation slot after freeing it",
  "find": "\tdelete[] p->constellations[0];",
  "replace": "\tdelete[] p->constellations[0];\n\tp->constellations[0] = 0;"
 },
 {
  "label": "null every coefficient slot after freeing it",
  "find": "\tdelete[] p->z2;",
  "replace": "\tdelete[] p->z2;\n\tp->z2 = 0;"
 },
 {
  "label": "delegate the null test to the allocator",
  "find": "\tdelete[] p->constellations[4];",
  "replace": "\tsysdep_free(p->constellations[4]);"
 },
 {
  "label": "invert the null test on a constellation slot",
  "find": "\tdelete[] p->constellations[3];",
  "replace": "\tif (p->constellations[3] == 0)\n\t\tsysdep_free(p->constellations[3]);"
 },
 {
  "label": "free the third coefficient bank twice and the fourth never",
  "find": "\tdelete[] p->p2;",
  "replace": "\tdelete[] p->z2;"
 }
]
