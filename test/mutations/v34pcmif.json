  "replace": "\tcase 9:\n"
 },
 {
  "label": "reneg: case 2 no longer steps down",
  "find": "\tcase 2:\n",
  "replace": "\tcase 9:\n"
 },
 {
  "label": "reneg: case 0 no longer steps down",
  "find": "\tcase 0:\n",
  "replace": "\tcase 9:\n"
 },
 {
  "label": "reneg: case 3 becomes case 4",
  "find": "\tcase 3:\n",
  "replace": "\tcase 4:\n"
 },
 {
  "label": "reneg: down clamp >= becomes >",
  "find": "want >= obj->rate_min",
  "replace": "want > obj->rate_min"
 },
 {
  "label": "reneg: up clamp <= becomes <",
  "find": "want <= obj->rate_max",
  "replace": "want < obj->rate_max"
 },
 {
  "label": "reneg: down clamp bounded by rate_max",
  "find": "want >= obj->rate_min",
  "replace": "want >= obj->rate_max"
 },
 {
  "label": "reneg: step reads rate_want not rate_now",
  "find": "want = (int)((unsigned)obj->rate_now - 1u);",
  "replace": "want = (int)((unsigned)obj->rate_want - 1u);"
 },
 {
  "label": "reneg: up step reads rate_want not rate_now",
  "find": "want = (int)((unsigned)obj->rate_now + 1u);",
  "replace": "want = (int)((unsigned)obj->rate_want + 1u);"
 },
 {
  "label": "reneg: default writes 0 rather than -1",
  "find": "obj->rate_want = -1;",
  "replace": "obj->rate_want = 0;"
 },
 {
  "label": "hangup: session flag byte not written",
  "find": "\t\tsess[0x173e] = 1;\n",
  "replace": ""
 },
 {
  "label": "hangup: session flag byte written as 2",
  "find": "sess[0x173e] = 1;",
  "replace": "sess[0x173e] = 2;"
 },
 {
  "label": "hangup: leaf code 1 rather than 2",
  "find": "+ 0x8c) = 2;",
  "replace": "+ 0x8c) = 1;"
 },
 {
  "label": "reneg: leaf gets a constant 2 rather than req",
  "find": "+ 0x8c) = req;",
  "replace": "+ 0x8c) = 2;"
 },
 {
  "label": "reneg: PCM arm writes the flag byte too",
  "find": "\t\tunsigned char *demod = *(unsigned char **)(sess + 0x175c);\n",
  "replace": "\t\tunsigned char *demod = *(unsigned char **)(sess + 0x175c);\n\n\t\tsess[0x173e] = 1;\n"
 },
 {
  "label": "reneg: PCM arm falls through instead of returning",
  "find": "*(int *)(*(unsigned char **)(demod + 0x20c) + 0x8c) = req;\n\t\treturn;",
  "replace": "*(int *)(*(unsigned char **)(demod + 0x20c) + 0x8c) = req;"
 },
 {
  "label": "hangup: PCM arm order swapped -- flag byte after the pointer load",
  "find": "\t\tsess[0x173e] = 1;\n\t\tdemod = *(unsigned char **)(sess + 0x175c);",
  "replace": "\t\tdemod = *(unsigned char **)(sess + 0x175c);\n\t\tsess[0x173e] = 1;",
  "equivalent": true,
  "why": "`sess + 0x173e` is a byte in the session and `sess + 0x175c` is a pointer field 30 bytes past it; the store and the load do not alias, so the order between them is not observable."
 },
 {
  "label": "hangup: clears rate_now as well",
  "find": "\tobj->rate_max = 0;\n",
  "replace": "\tobj->rate_max = 0;\n\tobj->rate_now = 0;\n"
 },
 {
  "label": "hangup: skips rate_min",
  "find": "\tobj->rate_min = 0;\n",
  "replace": ""
 },
