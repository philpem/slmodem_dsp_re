 {
  "label": "setv90: preinitdigital before the mask rather than after",
  "find": "\tobj->f25c2 = (short)((obj->f25c2 & ~0x4018) | 0x2000);\n\n\tpreinitdigital(obj);",
  "replace": "\tpreinitdigital(obj);\n\n\tobj->f25c2 = (short)((obj->f25c2 & ~0x4018) | 0x2000);",
  "equivalent": true,
  "why": "`preinitdigital` does not touch +0x25c2 -- which this mutation surviving a whole-object comparison is itself the evidence for."
 },
