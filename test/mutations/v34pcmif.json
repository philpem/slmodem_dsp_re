[
 {
  "note": "Recovered from the session that wrote these three functions; finding 189's tally is this set.  The two survivors are recorded as equivalent, not removed."
 },
 {
  "label": "hangup: status fork <=1 becomes <=2",
  "find": "\tobj->rate_max = 0;\n\n\tif ((unsigned)(obj->status - 1) <= 1) {",
  "replace": "\tobj->rate_max = 0;\n\n\tif ((unsigned)(obj->status - 1) <= 2) {"
 },
 {
  "label": "reneg: status fork <=1 becomes <=2",
  "find": "\tint want;\n\n\tif ((unsigned)(obj->status - 1) <= 1) {",
  "replace": "\tint want;\n\n\tif ((unsigned)(obj->status - 1) <= 2) {"
 },
 {
  "label": "setv90: rrn_type polarity swapped",
  "find": "(rrn_type != 0) ? 15 : 11",
  "replace": "(rrn_type != 0) ? 11 : 15"
 },
 {
  "label": "setv90: rrn_type tested for sign",
  "find": "(rrn_type != 0) ? 15 : 11",
  "replace": "(rrn_type > 0) ? 15 : 11"
 },
 {
  "label": "setv90: constel polarity swapped",
  "find": "constel_size != 0 ? 0x89b0 : 0x8990",
  "replace": "constel_size != 0 ? 0x8990 : 0x89b0"
 },
 {
  "label": "setv90: constel read signed",
  "find": "constel_size != 0 ? 0x89b0 : 0x8990",
  "replace": "(signed char)constel_size > 0 ? 0x89b0 : 0x8990"
 },
 {
  "label": "setv90: v90_receiver not set",
  "find": "\tobj->v90_receiver = (rrn_type != 0) ? 15 : 11;\n",
  "replace": ""
 },
 {
  "label": "reneg: case 5 no longer steps down",
