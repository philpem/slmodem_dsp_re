[
 {
  "note": "Recovered from the session that reconstructed v34handshakinit and the state trace.  The three state words and the 87 StateName entries are what most of these attack: a transposition there reads correctly and is wrong everywhere."
 },
 {
  "label": "rxstate and txstate offsets transposed",
  "find": "#define HS_RXSTATE\t0x3594",
  "replace": "#define HS_RXSTATE\t0x3596"
 },
 {
  "label": "microstate context fed from rxstate twice",
  "find": "\t\tif (off == HS_MICROSTATE) {\n\t\t\tctx1 = StateName[hs_get(obj, HS_TXSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_RXSTATE)];",
  "replace": "\t\tif (off == HS_MICROSTATE) {\n\t\t\tctx1 = StateName[hs_get(obj, HS_RXSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_TXSTATE)];"
 },
 {
  "label": "HS_RXSTATE branch ctx1/ctx2 swapped",
  "find": "\t\t} else if (off == HS_RXSTATE) {\n\t\t\tctx1 = StateName[hs_get(obj, HS_TXSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_MICROSTATE)];",
  "replace": "\t\t} else if (off == HS_RXSTATE) {\n\t\t\tctx1 = StateName[hs_get(obj, HS_MICROSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_TXSTATE)];"
 },
 {
  "label": "HS_TXSTATE branch ctx1/ctx2 swapped",
  "find": "\t\t} else {\n\t\t\tctx1 = StateName[hs_get(obj, HS_RXSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_MICROSTATE)];",
  "replace": "\t\t} else {\n\t\t\tctx1 = StateName[hs_get(obj, HS_MICROSTATE)];\n\t\t\tctx2 = StateName[hs_get(obj, HS_RXSTATE)];"
 },
 {
  "label": "[1] and [2] counters swapped",
  "find": "(long)hs_get(obj, HS_TRACE_1),",
  "replace": "(long)hs_get(obj, HS_TRACE_2),"
 },
 {
  "label": "StateName DET_SYNC and DET_CJ transposed",
  "find": "\"DET_CM_JM\",\t\"DET_SYNC\",\t\"DET_CJ\",\t\"RX_DPSK\",",
  "replace": "\"DET_CM_JM\",\t\"DET_CJ\",\t\"DET_SYNC\",\t\"RX_DPSK\","
 },
 {
  "label": "timer guard signed rather than unsigned",
  "find": "unsigned d = (unsigned)(*(int *)(m + 0x238) - delta);",
  "replace": "int d = *(int *)(m + 0x238) - delta;"
 },
 {
  "label": "timer limit 0x176ff becomes 0x17700",
  "find": "if (d <= 0x176ff)",
  "replace": "if (d <= 0x17700)"
 },
 {
  "label": "mode 1's || becomes &&",
  "find": "if ((rx->flags & 0x40) || m[0xac17] != 0) {",
  "replace": "if ((rx->flags & 0x40) && m[0xac17] != 0) {"
 },
 {
  "label": "mode 0 tests 0x65 rather than 0x66",
  "find": "if (obj->f359c == 0x66)",
  "replace": "if (obj->f359c == 0x65)"
 },
 {
  "label": "mode 4 detector pair the other way round",
  "find": "(obj->f359c == 0x65) ? c2400_ : c1200_,",
  "replace": "(obj->f359c == 0x65) ? c1200_ : c2400_,"
 },
 {
  "label": "mode 2 rxflags mask ~0x1d8 becomes ~0x1f8 (bit 5, outside the OR)",
  "find": "(rx->flags & ~0x1d8) | 0x18",
  "replace": "(rx->flags & ~0x1f8) | 0x18"
 },
 {
  "label": "mode 2 rxflags mask ~0x1d8 becomes ~0x1c8",
  "find": "(rx->flags & ~0x1d8) | 0x18",
  "replace": "(rx->flags & ~0x1c8) | 0x18",
  "equivalent": true,
  "why": "0x1d8 and 0x1c8 differ only in bit 4, and 0x18 -- which contains bit 4 -- is OR-ed straight back in, so the cleared bit is restored in the same expression."
 },
 {
  "label": "mode 2 txflags mask ~0x4018 becomes ~0x4010",
  "find": "(obj->f25c2 & ~0x4018) | 0x2000",
  "replace": "(obj->f25c2 & ~0x4010) | 0x2000"
 },
 {
  "label": "prologue txflags mask dropped entirely",
  "find": "obj->f25c2 = (short)(obj->f25c2 & 0x7fff);",
  "replace": ""
 },
 {
  "label": "prologue txflags 0x7fff becomes 0x3fff",
  "find": "obj->f25c2 & 0x7fff",
  "replace": "obj->f25c2 & 0x3fff"
 },
 {
  "label": "out-of-range mode skips the tail",
  "find": "\tdefault:\n\t\t/* Out of range runs the tail, and nothing else. */\n\t\tbreak;",
  "replace": "\tdefault:\n\t\treturn;"
 },
 {
  "label": "timer stride 0x69780 becomes 0x69700",
  "find": "base + 0x69780",
  "replace": "base + 0x69700"
 },
 {
  "label": "timer mark reset to 0 rather than 0xfff15a00",
  "find": "*(int *)(m + 0x248) = (int)0xfff15a00;",
  "replace": "*(int *)(m + 0x248) = 0;"
 },
 {
  "label": "mode 0 points 0xaa70 at the 0xa94c record",
  "find": "\t\trx->flags = (unsigned short)(rx->flags | 0x1000);\n\t\t*(short **)(m + 0xaa70) = (short *)(m + 0xa97c);\n\t\ths_put(obj, 0xa97c + 0x18, 0x11);",
  "replace": "\t\trx->flags = (unsigned short)(rx->flags | 0x1000);\n\t\t*(short **)(m + 0xaa70) = (short *)(m + 0xa94c);\n\t\ths_put(obj, 0xa97c + 0x18, 0x11);"
 },
 {
  "label": "mode 0 record index 12 gets 8 rather than 0x11",
  "find": "hs_put(obj, 0xa97c + 0x18, 0x11);",
  "replace": "hs_put(obj, 0xa97c + 0x18, 8);"
 },
 {
  "label": "mode 4 record index 12 gets 0x11 rather than 8",
  "find": "hs_put(obj, 0xa97c + 0x18, 8);",
  "replace": "hs_put(obj, 0xa97c + 0x18, 0x11);"
 },
 {
  "label": "mode 4 points 0xaa6c at the 0xa97c record",
  "find": "*(short **)(m + 0xaa6c) = (short *)(m + 0xa94c);",
  "replace": "*(short **)(m + 0xaa6c) = (short *)(m + 0xa97c);"
 },
 {
  "label": "mode 4 record 0xa94c: +0x24 constant off by one",
  "find": "*(int *)(r + 0x24) = 0xf72;",
  "replace": "*(int *)(r + 0x24) = 0xf73;"
 },
 {
  "label": "mode 1 bumps 0xac12 where it should bump 0xac14",
  "find": "\t\t\tm[0xac17] = 0;\n\t\t\ths_put(obj, 0xac14, n);",
  "replace": "\t\t\tm[0xac17] = 0;\n\t\t\ths_put(obj, 0xac12, n);"
 },
 {
  "label": "mode 1 does not clear the 0xac17 byte",
  "find": "\t\t\tm[0xac17] = 0;\n\t\t\ths_put(obj, 0xac14, n);",
  "replace": "\t\t\ths_put(obj, 0xac14, n);"
 },
 {
  "label": "mode 1 transitions the microstate it should leave alone",
  "find": "\t\ths_setstate(obj, HS_RXSTATE, V34HS_WAIT);\n\t\t/* No microstate transition here; mode 1 is the only body\n\t\t * that leaves it alone. */",
  "replace": "\t\ths_setstate(obj, HS_RXSTATE, V34HS_WAIT);\n\t\ths_setstate(obj, HS_MICROSTATE, V34HS_DET_SYNC);"
 },
 {
  "label": "tail: 0xaa3c and 0x2aa0 values swapped",
  "find": "\ths_put(obj, 0xaa3c, 0);\n\ths_put(obj, 0x2aa0, 0x10);",
  "replace": "\ths_put(obj, 0xaa3c, 0x10);\n\ths_put(obj, 0x2aa0, 0);"
 },
 {
  "label": "tail: 0x2aa0 value 0x10 becomes 0x11",
  "find": "hs_put(obj, 0x2aa0, 0x10);",
  "replace": "hs_put(obj, 0x2aa0, 0x11);"
 },
 {
  "label": "fmt[] rxstate and txstate entries permuted, offsets untouched",
  "find": "\t\t\"V34HSHAKE: rxstate %s=>%s(tx %s, mst %s, [1]%ld, [2]%ld)\\n\",\n\t\t/* HS_TXSTATE */\n\t\t\"V34HSHAKE: txstate %s=>%s(rx %s, mst %s, [1]%ld, [2]%ld)\\n\"",
  "replace": "\t\t\"V34HSHAKE: txstate %s=>%s(rx %s, mst %s, [1]%ld, [2]%ld)\\n\",\n\t\t/* HS_TXSTATE */\n\t\t\"V34HSHAKE: rxstate %s=>%s(tx %s, mst %s, [1]%ld, [2]%ld)\\n\""
 },
 {
  "label": "fmt[] microstate entry moved to the rxstate slot",
  "find": "\t\t\"V34HSHAKE: microstate %s=>%s(tx %s, rx %s, [1]%ld, [2]%ld)\\n\",",
  "replace": "\t\t\"V34HSHAKE: rxstate %s=>%s(tx %s, mst %s, [1]%ld, [2]%ld)\\n\","
 },
 {
  "note": "The five DFT leaves.  Three of them are pure table fills, where the only errors possible are a bin number, a bank length and which of the two `nl` banks is which -- and the last of those is invisible to anything but a differential compare, because both banks are the same shape.  detectRetrainReq is the state machine, and its two comparisons are widened differently on each side."
 },
 {
  "label": "dftfreqinit fills 24 bins",
  "find": "for (i = 1; i <= 25; i++, bins++) {",
  "replace": "for (i = 1; i <= 24; i++, bins++) {"
 },
 {
  "label": "dftfreqinit is zero-based",
  "find": "for (i = 1; i <= 25; i++, bins++) {",
  "replace": "for (i = 0; i <= 25; i++, bins++) {"
 },
 {
  "label": "the bin number is shifted 7, not 8",
  "find": "#define DFT_BIN(n)\t((short)((n) << 8))",
  "replace": "#define DFT_BIN(n)\t((short)((n) << 7))"
 },
 {
  "label": "dftfreqinit leaves denergy alone",
  "find": "\t\tbins->denergy = 0.0;\n",
  "replace": ""
 },
 {
  "label": "dftfreqinit leaves the double accumulators alone",
  "find": "\t\tbins->sum_re = 0.0;\n\t\tbins->sum_im = 0.0;\n",
  "replace": ""
 },
 {
  "label": "signal bins 7 and 9 transposed",
  "find": "\tbins[0].inc = DFT_BIN(7);\n\tbins[1].inc = DFT_BIN(9);",
  "replace": "\tbins[0].inc = DFT_BIN(9);\n\tbins[1].inc = DFT_BIN(7);"
 },
 {
  "label": "signal bin 17 becomes 18",
  "find": "\tbins[3].inc = DFT_BIN(17);",
  "replace": "\tbins[3].inc = DFT_BIN(18);"
 },
 {
  "label": "the signal bank clears three bins",
  "find": "\t */\n\tfor (i = 0; i <= 3; i++) {",
  "replace": "\t */\n\tfor (i = 0; i <= 2; i++) {"
 },
 {
  "label": "noise bin 12 becomes 11",
  "find": "\tbins[2].inc = DFT_BIN(12);\n\tbins[3].inc = DFT_BIN(16);",
  "replace": "\tbins[2].inc = DFT_BIN(11);\n\tbins[3].inc = DFT_BIN(16);"
 },
 {
  "label": "the noise bank clears three bins",
  "find": "\tshort i;\n\n\tfor (i = 0; i <= 3; i++) {",
  "replace": "\tshort i;\n\n\tfor (i = 0; i <= 2; i++) {"
 },
 {
  "label": "the noise bank gets the signal bank's frequencies",
  "find": "\tbins[0].inc = DFT_BIN(6);\n\tbins[1].inc = DFT_BIN(8);\n\tbins[2].inc = DFT_BIN(12);\n\tbins[3].inc = DFT_BIN(16);",
  "replace": "\tbins[0].inc = DFT_BIN(7);\n\tbins[1].inc = DFT_BIN(9);\n\tbins[2].inc = DFT_BIN(13);\n\tbins[3].inc = DFT_BIN(17);"
 },
 {
  "label": "the retrain thresholds transposed",
  "find": "\t\tbins[i].thresh_lo = RETRAIN_QUIET;\n\t\tbins[i].thresh_hi = RETRAIN_TONE;",
  "replace": "\t\tbins[i].thresh_lo = RETRAIN_TONE;\n\t\tbins[i].thresh_hi = RETRAIN_QUIET;"
 },
 {
  "label": "the quiet threshold is 0x51",
  "find": "#define RETRAIN_QUIET\t0x50",
  "replace": "#define RETRAIN_QUIET\t0x51"
 },
 {
  "label": "the tone threshold is 0xbb9",
  "find": "#define RETRAIN_TONE\t0xbb8",
  "replace": "#define RETRAIN_TONE\t0xbb9"
 },
 {
  "label": "the retrain detector's top bin is 1800 Hz",
  "find": "\tbins[2].inc = DFT_BIN(10);",
  "replace": "\tbins[2].inc = DFT_BIN(12);"
 },
 {
  "label": "dftRetrainDetInit arms two bins",
  "find": "\tfor (i = 0; i <= 2; i++) {",
  "replace": "\tfor (i = 0; i <= 1; i++) {"
 },
 {
  "label": "the two run limits transposed",
  "find": "\tobj->retrain_quiet_runs = 3;\n\tobj->retrain_tone_runs = 9;",
  "replace": "\tobj->retrain_quiet_runs = 9;\n\tobj->retrain_tone_runs = 3;"
 },
 {
  "label": "the detector arms in state 2",
  "find": "\tobj->retrain_state = 1;\n\tobj->retrain_phase = 0;",
  "replace": "\tobj->retrain_state = 2;\n\tobj->retrain_phase = 0;"
 },
 {
  "label": "the sample counter steps by two",
  "find": "\tobj->retrain_phase += 4;",
  "replace": "\tobj->retrain_phase += 2;"
 },
 {
  "label": "the window test is < rather than !=",
  "find": "\tif (obj->retrain_phase != 0x80)",
  "replace": "\tif (obj->retrain_phase < 0x80)"
 },
 {
  "label": "dftenergy is given a scale of 4",
  "find": "\tdftenergy(bins, nbins, 5);",
  "replace": "\tdftenergy(bins, nbins, 4);"
 },
 {
  "label": "the clear loop covers the whole bank, not the caller's prefix",
  "find": "\tfor (i = 0; i < nbins; i++) {",
  "replace": "\tfor (i = 0; i < V34_RETRAIN_BINS; i++) {"
 },
 {
  "label": "the clear loop resets the double accumulators too",
  "find": "\t\tbins[i].acc_im = 0;\n\t}\n\n\tif (obj->retrain_state == 1) {",
  "replace": "\t\tbins[i].acc_im = 0;\n\t\tbins[i].sum_re = 0.0;\n\t\tbins[i].sum_im = 0.0;\n\t}\n\n\tif (obj->retrain_state == 1) {"
 },
 {
  "label": "the quiet test on bin 0 is <=",
  "find": "\t\t\t\t\t< (int)bins[0].thresh_lo",
  "replace": "\t\t\t\t\t<= (int)bins[0].thresh_lo"
 },
 {
  "label": "bin 2 is compared against bin 1's threshold",
  "find": "\t\t\t\t\t< (int)bins[2].thresh_lo",
  "replace": "\t\t\t\t\t< (int)bins[1].thresh_lo"
 },
 {
  "label": "the quiet threshold is widened unsigned",
  "find": "\t\t\t\t\t< (int)bins[0].thresh_lo",
  "replace": "\t\t\t\t\t< (int)(unsigned short)bins[0].thresh_lo"
 },
 {
  "label": "bin 0's energy is widened signed",
  "find": "\t\tif ((int)(unsigned short)bins[0].energy",
  "replace": "\t\tif ((int)bins[0].energy",
  "equivalent": true,
  "why": "`energy` is `(short)((int)e >> 16)` where e is a sum of two squares of 16-bit values, so it is negative only when e reaches 2^31 -- both squares at full scale at once.  A sweep of all 32767 amplitudes of a 1200 Hz sine through the detector produced no negative energy, so no input distinguishes the two widenings.  Reproduced from the `movzwl` and recorded here rather than left to look tested.  Finding 204."
 },
 {
  "label": "the quiet run test is > rather than >=",
  "find": "\t\t\tif (obj->retrain_runs >= obj->retrain_quiet_runs)",
  "replace": "\t\t\tif (obj->retrain_runs > obj->retrain_quiet_runs)"
 },
 {
  "label": "the state-2 guard tests 3",
  "find": "\tif (obj->retrain_state != 2)",
  "replace": "\tif (obj->retrain_state != 3)"
 },
 {
  "label": "the tone test reads bin 0",
  "find": "\tif ((int)(unsigned short)bins[1].energy > (int)bins[1].thresh_hi) {",
  "replace": "\tif ((int)(unsigned short)bins[0].energy > (int)bins[0].thresh_hi) {"
 },
 {
  "label": "the tone test is >=",
  "find": "\tif ((int)(unsigned short)bins[1].energy > (int)bins[1].thresh_hi) {",
  "replace": "\tif ((int)(unsigned short)bins[1].energy >= (int)bins[1].thresh_hi) {"
 },
 {
  "label": "the tone threshold is widened unsigned",
  "find": "\tif ((int)(unsigned short)bins[1].energy > (int)bins[1].thresh_hi) {",
  "replace": "\tif ((int)(unsigned short)bins[1].energy > (int)(unsigned short)bins[1].thresh_hi) {"
 },
 {
  "label": "the give-up arm returns instead of sharing the tail",
  "find": "\t} else {\n\t\tobj->retrain_runs = 0;\n\t\tobj->retrain_state = 1;\n\t}",
  "replace": "\t} else {\n\t\tobj->retrain_runs = 0;\n\t\tobj->retrain_state = 1;\n\t\treturn 0;\n\t}"
 },
 {
  "label": "the answer compares against the quiet limit",
  "find": "\treturn obj->retrain_runs == obj->retrain_tone_runs;",
  "replace": "\treturn obj->retrain_runs == obj->retrain_quiet_runs;"
 },
 {
  "label": "the answer is >= rather than ==",
  "find": "\treturn obj->retrain_runs == obj->retrain_tone_runs;",
  "replace": "\treturn obj->retrain_runs >= obj->retrain_tone_runs;"
 }
]
