  "find": "\tcfg.max_freq = 80;",
  "replace": "\tcfg.max_freq = 81;"
 },
 {
  "label": "RD_create's minOnDur is 121",
  "find": "\tcfg.min_on_dur = 120;",
  "replace": "\tcfg.min_on_dur = 121;"
 },
 {
