  "replace": "\tsineWave.phase = 0.0f;\n\tbyte_6118 = 0;"
 },
 {
  "label": "the demod-over arm does not narrow the status to sixteen bits",
  "find": "\t\tverificationStatus = (unsigned short)\n\t\t    modem.demodulator->phase3Demodulator->verificationStatus;",
  "replace": "\t\tverificationStatus =\n\t\t    modem.demodulator->phase3Demodulator->verificationStatus;"
 },
 {
  "label": "the no-status half does not narrow the status to sixteen bits",
  "find": "\t\t\tverificationStatus = (unsigned short)modem.demodulator\n\t\t\t    ->phase3Demodulator->verificationStatus;",
  "replace": "\t\t\tverificationStatus = modem.demodulator\n\t\t\t    ->phase3Demodulator->verificationStatus;"
