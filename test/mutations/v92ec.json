[
 {
  "label": "fold the delta in after the store (old delay lost)",
  "find": "\techoLength += delay - echoDelay;\n\techoDelay = delay;",
  "replace": "\techoDelay = delay;\n\techoLength += delay - echoDelay;"
 },
 {
  "label": "the tap count follows the delay, not the change",
  "find": "\techoLength += delay - echoDelay;",
  "replace": "\techoLength = delay;"
 },
 {
  "label": "the delta is subtracted, not added",
  "find": "\techoLength += delay - echoDelay;",
  "replace": "\techoLength -= delay - echoDelay;"
 },
 {
  "label": "print the field rather than the argument",
  "find": "\"V92EchoCanceller: echoDelay updated to: %d\\n\", delay);",
  "replace": "\"V92EchoCanceller: echoDelay updated to: %d\\n\", echoLength);"
 },
 {
  "label": "the coefficient loop is bounded by the tap count, not the filter length",
  "find": "\tfor (i = 0; i < filterLength; i++)\n\t\techoCoeff[i] = 0.0f;",
  "replace": "\tfor (i = 0; i < echoLength; i++)\n\t\techoCoeff[i] = 0.0f;"
 },
 {
  "label": "the coefficient loop runs one entry long",
  "find": "\tfor (i = 0; i < filterLength; i++)\n\t\techoCoeff[i] = 0.0f;",
  "replace": "\tfor (i = 0; i <= filterLength; i++)\n\t\techoCoeff[i] = 0.0f;"
 },
 {
  "label": "the coefficient loop runs one entry short",
  "find": "\tfor (i = 0; i < filterLength; i++)\n\t\techoCoeff[i] = 0.0f;",
  "replace": "\tfor (i = 1; i < filterLength; i++)\n\t\techoCoeff[i] = 0.0f;"
 },
 {
  "label": "the coefficient loop clears the history instead",
  "find": "\tfor (i = 0; i < filterLength; i++)\n\t\techoCoeff[i] = 0.0f;",
  "replace": "\tfor (i = 0; i < filterLength; i++)\n\t\techoHistory[i] = 0.0f;"
 },
 {
  "label": "the write cursor is not rewound",
  "find": "\thistoryIndex = 0;\n\techoLength =",
  "replace": "\techoLength ="
 },
 {
  "label": "the filter length is not halved",
  "find": "\techoLength = (filterLength >> 1) + echoDelay",
  "replace": "\techoLength = filterLength + echoDelay"
 },
 {
  "label": "the filter length is quartered",
  "find": "\techoLength = (filterLength >> 1) + echoDelay",
  "replace": "\techoLength = (filterLength >> 2) + echoDelay"
 },
 {
  "label": "the parameter block's delay offset is left out of the tap count",
  "find": "\t\t     + (unsigned int)params->V92_ECHO_DELAY_OFFSET;",
  "replace": "\t\t     + 0u;"
 },
 {
  "label": "the tap count is built from the initial delay, not the delay offset",
  "find": "params->V92_ECHO_DELAY_OFFSET;",
  "replace": "params->V92_ECHO_INITIAL_DELAY;"
 },
 {
  "label": "the history loop uses the filter length, not the tap count",
  "find": "\tfor (i = 0; i < echoLength; i++)\n\t\techoHistory[i] = 0.0f;",
  "replace": "\tfor (i = 0; i < filterLength; i++)\n\t\techoHistory[i] = 0.0f;"
 },
 {
  "label": "the history loop runs one entry long",
  "find": "\tfor (i = 0; i < echoLength; i++)\n\t\techoHistory[i] = 0.0f;",
  "replace": "\tfor (i = 0; i <= echoLength; i++)\n\t\techoHistory[i] = 0.0f;"
 },
 {
  "label": "the tap count is left at zero after the loop that uses it",
  "find": "\techoLength = (filterLength >> 1) + echoDelay\n\t\t     + (unsigned int)params->V92_ECHO_DELAY_OFFSET;\n\tfor (i = 0; i < echoLength; i++)\n\t\techoHistory[i] = 0.0f;",
  "replace": "\tfor (i = 0; i < (filterLength >> 1) + echoDelay\n\t\t     + (unsigned int)params->V92_ECHO_DELAY_OFFSET; i++)\n\t\techoHistory[i] = 0.0f;\n\techoLength = 0;"
 },
 {
  "label": "word_08 is left alone",
  "find": "\tword_08 = 0;\n\n\techoBeta = 0.0f;",
  "replace": "\techoBeta = 0.0f;"
 },
 {
  "label": "the beta is cleared and the decay factor is not",
  "find": "\techoBetaDecay = 0.0f;\n\tedprintf(\"V92EchoCanceller: echoBetaDecay",
  "replace": "\tedprintf(\"V92EchoCanceller: echoBetaDecay"
 },
 {
  "label": "the two diagnostics print each other's format string",
  "find": "\tedprintf(\"V92EchoCanceller: echoBeta = %c%d.%06d\\r\\n\", '-', 0, 0);",
  "replace": "\tedprintf(\"V92EchoCanceller: echoBetaDecay = %c%d.%06d\\r\\n\", '-', 0, 0);"
 },
 {
  "label": "the sign character folds to '+' rather than '-'",
  "find": "\tedprintf(\"V92EchoCanceller: echoBeta = %c%d.%06d\\r\\n\", '-', 0, 0);",
  "replace": "\tedprintf(\"V92EchoCanceller: echoBeta = %c%d.%06d\\r\\n\", '+', 0, 0);"
 },
 {
  "label": "the ARMA behind the canceller is not reset",
  "find": "\tarma->reset();",
  "replace": "\t(void)arma;"
 },
 {
  "label": "the destruction notice is gated one level too low",
  "find": "\tif (DSPLIB_DEBUG_ON())\n\t\tdsplibs_debug_printf(\"V92EchoCanceller Destruction",
  "replace": "\tif (dsplibs_debug_level != 0)\n\t\tdsplibs_debug_printf(\"V92EchoCanceller Destruction"
 },
 {
  "label": "the coefficient array is freed but not nulled",
  "find": "\t\tsysdep_free(echoCoeff);\n\t\techoCoeff = NULL;",
  "replace": "\t\tsysdep_free(echoCoeff);"
 },
 {
  "label": "the history is freed but not nulled",
  "find": "\t\tsysdep_free(echoHistory);\n\t\techoHistory = NULL;",
  "replace": "\t\tsysdep_free(echoHistory);"
 },
 {
  "label": "the ARMA pointer is freed but not nulled",
  "find": "\t\tsysdep_free(arma);\n\t\tarma = NULL;",
  "replace": "\t\tsysdep_free(arma);"
 },
 {
  "label": "the ARMA is freed without being destroyed",
  "find": "\t\tarma->~FloatARMA();\n\t\tsysdep_free(arma);",
  "replace": "\t\tsysdep_free(arma);"
 },
 {
  "label": "the ARMA pointer is nulled before it is freed",
  "find": "\t\tarma->~FloatARMA();\n\t\tsysdep_free(arma);\n\t\tarma = NULL;",
  "replace": "\t\tarma->~FloatARMA();\n\t\tarma = NULL;\n\t\tsysdep_free(arma);"
 },
 {
  "label": "the history is freed twice and the coefficients not at all",
  "find": "\tif (echoCoeff != NULL) {\n\t\tsysdep_free(echoCoeff);\n\t\techoCoeff = NULL;\n\t}",
  "replace": "\tif (echoHistory != NULL) {\n\t\tsysdep_free(echoHistory);\n\t\techoHistory = NULL;\n\t}"
 },
 {
  "label": "the null guards are dropped",
  "find": "\tif (echoCoeff != NULL) {\n\t\tsysdep_free(echoCoeff);\n\t\techoCoeff = NULL;\n\t}",
  "replace": "\t{\n\t\tsysdep_free(echoCoeff);\n\t\techoCoeff = NULL;\n\t}"
 }
]
