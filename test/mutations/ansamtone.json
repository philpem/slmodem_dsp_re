  "replace": "\t: GenericToneDetector(sampleRate == ANSAM_RATE_13 ? 11u : 13u,\n\t\t\t      sampleRate == ANSAM_RATE_13 ? 11u : 13u,"
 },
 {
  "label": "the numerator is passed as the denominator and back",
