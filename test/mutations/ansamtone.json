[
 {
  "label": "the selector rate is 9600 rather than 8000",
  "find": "#define ANSAM_RATE_13\t8000u",
  "replace": "#define ANSAM_RATE_13\t9600u"
 },
 {
  "label": "the tap count is 13 whatever the rate",
