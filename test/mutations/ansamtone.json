  "replace": "\t\t\t      sampleRate == ANSAM_RATE_13 ? IIR2100_Coef_B_8000\n\t\t\t\t\t\t\t  : IIR2100_Coef_B_9600,\n\t\t\t      sampleRate == ANSAM_RATE_13 ? IIR2100_Coef_A_8000\n\t\t\t\t\t\t\t  : IIR2100_Coef_A_9600,"
 },
 {
